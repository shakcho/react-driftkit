---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import InstallSection from '../components/InstallSection.astro';
import GitHubCTA from '../components/GitHubCTA.astro';
import { MoveIcon, DockGlyphIcon, SheetIcon, SplitterIcon, ZoomLensIcon, FlickDeckIcon } from '../components/islands/Icons';
import { allComponents } from '../data/components';
import pkg from '../../../package.json';

const title = 'react-driftkit — React draggable, resizable & floating UI components';
const description =
  'react-driftkit is a free, tree-shakable React component library of floating UI primitives: a draggable widget launcher, edge-pinned dock, draggable bottom sheet, resizable split pane, image magnifier (zoom lens), and card-stack flick deck. Unstyled, TypeScript-first, zero dependencies, works with React 18 and React 19.';
const keywords = [
  'react-driftkit',
  'react draggable component',
  'react resizable split pane',
  'react bottom sheet',
  'react draggable widget',
  'react magnifier',
  'react zoom lens',
  'react floating ui library',
  'react dock component',
  'react card stack',
  'react tree-shakable component library',
  'react 19 ui components',
  'typescript react components',
  'unstyled react components',
].join(', ');

const icons: Record<string, typeof MoveIcon> = {
  launcher: MoveIcon,
  dock: DockGlyphIcon,
  sheet: SheetIcon,
  splitter: SplitterIcon,
  zoomlens: ZoomLensIcon,
  flickdeck: FlickDeckIcon,
};

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'react-driftkit',
  description,
  codeRepository: 'https://github.com/shakcho/react-driftkit',
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'React 18, React 19',
  license: 'https://github.com/shakcho/react-driftkit/blob/main/LICENSE',
  url: 'https://react-driftkit.saktichourasia.dev/',
  author: {
    '@type': 'Person',
    name: 'Sakti Kumar Chourasia',
    url: 'https://saktichourasia.dev',
  },
  sameAs: [
    'https://www.npmjs.com/package/react-driftkit',
    'https://github.com/shakcho/react-driftkit',
  ],
};

const softwareApplicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'react-driftkit',
  description,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'React component library',
  operatingSystem: 'Cross-platform (browser)',
  softwareVersion: pkg.version,
  downloadUrl: 'https://www.npmjs.com/package/react-driftkit',
  url: 'https://react-driftkit.saktichourasia.dev/',
  image: 'https://react-driftkit.saktichourasia.dev/og/home.png',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  author: {
    '@type': 'Person',
    name: 'Sakti Kumar Chourasia',
    url: 'https://saktichourasia.dev',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'react-driftkit',
  url: 'https://react-driftkit.saktichourasia.dev/',
  description,
  inLanguage: 'en-US',
};

const useCases = [
  {
    h: 'React draggable widget / chat launcher',
    p: 'Pin a chat bubble, AI assistant, support widget, or debug panel to a viewport corner with snap-on-release.',
    href: '/movable-launcher',
    cta: 'See MovableLauncher →',
  },
  {
    h: 'React bottom sheet & pull-up drawer',
    p: 'Mobile-style filters, cart drawers, and detail panels with peek / half / full snap points and velocity-aware release.',
    href: '/draggable-sheet',
    cta: 'See DraggableSheet →',
  },
  {
    h: 'React resizable split pane (N-pane layouts)',
    p: 'IDE-style split layouts with draggable handles, min/max constraints, and localStorage-persisted ratios — horizontal or vertical.',
    href: '/resizable-split-pane',
    cta: 'See ResizableSplitPane →',
  },
  {
    h: 'React image magnifier / product zoom lens',
    p: 'Drop-in magnifier circle for product images, design review, dense data tables, or map inspection. Wheel to zoom, Escape to dismiss.',
    href: '/zoom-lens',
    cta: 'See ZoomLens →',
  },
  {
    h: 'React floating dock / toolbar',
    p: 'Edge-pinned dock that slides along any side and flips orientation between horizontal and vertical layouts automatically.',
    href: '/snap-dock',
    cta: 'See SnapDock →',
  },
  {
    h: 'React card stack / swipeable cards',
    p: 'Peek-and-flick stack for tip cards, side-by-side comparisons, view toggles, or onboarding flows. Optional swipe-to-dismiss.',
    href: '/flick-deck',
    cta: 'See FlickDeck →',
  },
];

const faq = [
  {
    q: 'What is react-driftkit?',
    a: 'react-driftkit is a small, tree-shakable React library of floating UI primitives — draggable launchers, edge-pinned docks, pull-up sheets, resizable split panes, and a draggable zoom lens. It ships unstyled so it works with Tailwind, CSS Modules, or any design system, and has zero runtime dependencies.',
  },
  {
    q: 'Does react-driftkit support React 19?',
    a: 'Yes. react-driftkit declares peer dependencies of react@^18 || ^19 and react-dom@^18 || ^19, so it works with React 18 and React 19 without changes.',
  },
  {
    q: 'What components does react-driftkit include?',
    a: 'Six components: MovableLauncher (draggable corner widget with snap-to-corners), SnapDock (edge-pinned dock that flips orientation), DraggableSheet (pull-up/pull-down sheet with peek/half/full snap points), ResizableSplitPane (N-pane split layout with draggable handles and localStorage persistence), ZoomLens (draggable magnifier circle, or target-scoped product-image zoom), and FlickDeck (peek-and-flick card stack).',
  },
  {
    q: 'How do I install react-driftkit?',
    a: 'Install with npm install react-driftkit, yarn add react-driftkit, or pnpm add react-driftkit. It has zero runtime dependencies and tree-shakes — only the components you import are bundled.',
  },
  {
    q: 'Is react-driftkit styled?',
    a: 'No. react-driftkit ships unstyled primitives — you bring your own CSS, Tailwind, CSS Modules, or design system. Each component exposes data attributes (like data-edge, data-orientation, data-dragging) so you can drive styles from CSS without re-rendering.',
  },
  {
    q: 'Does react-driftkit work on touch devices?',
    a: 'Yes. All components use Pointer Events and lock each gesture to the initiating pointer, so mouse, touch, and pen input all work without extra wiring. Fast drags, pointer cancellation, and lost capture are handled.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout
  title={title}
  description={description}
  path="/"
  keywords={keywords}
  jsonLd={[softwareJsonLd, softwareApplicationJsonLd, websiteJsonLd, faqJsonLd]}
>
  <Hero
    title="react-driftkit"
    taglineHtml="A small, tree-shakable React component library for floating UI: <strong>draggable widgets</strong>, an <strong>edge-pinned dock</strong>, a <strong>draggable bottom sheet</strong>, an <strong>N-pane resizable split pane</strong>, an <strong>image magnifier (zoom lens)</strong>, and a <strong>peek-and-flick card stack</strong>. Unstyled, TypeScript-first, zero dependencies, React 18 &amp; React 19."
  />

  <section class="section" style="padding-top: 16px;">
    <div class="section-label">What's inside</div>
    <div class="component-grid">
      {allComponents.map((c) => {
        const Icon = icons[c.key];
        return (
          <a href={`/${c.slug}`} class="component-card">
            <span class="component-card-icon" aria-hidden="true">
              <Icon size={28} />
            </span>
            <h3 class="component-card-title">{c.title}</h3>
            <p class="component-card-description">{c.tagline}</p>
          </a>
        );
      })}
    </div>
  </section>

  <InstallSection id="install" />

  <section id="use-cases" class="section">
    <div class="section-label">Use cases</div>
    <h2 class="section-heading">What you can build with react-driftkit</h2>
    <p class="section-lede">
      Each component maps to a recurring UI pattern in modern React apps. Use one,
      compose several, or pull in just the primitive you need — every export
      tree-shakes independently.
    </p>
    <div class="why-grid">
      {useCases.map((u) => (
        <div class="why-item">
          <h3>{u.h}</h3>
          <p>{u.p}</p>
          <p style="margin-top:8px"><a href={u.href} class="use-case-link">{u.cta}</a></p>
        </div>
      ))}
    </div>
  </section>

  <section id="why" class="section">
    <div class="section-label">Why react-driftkit</div>
    <div class="why-grid">
      <div class="why-item">
        <h3>Tree-shakable</h3>
        <p>Each component is independently exported. Import only what you use and the rest is dropped from your bundle.</p>
      </div>
      <div class="why-item">
        <h3>Unstyled</h3>
        <p>Zero opinions about how your UI looks. Style with CSS, Tailwind, CSS Modules, or any design system. Data attributes drive layout state.</p>
      </div>
      <div class="why-item">
        <h3>Zero dependencies</h3>
        <p>No runtime dependencies. Small footprint. React 18 and React 19 supported out of the box.</p>
      </div>
      <div class="why-item">
        <h3>Pointer-first</h3>
        <p>Mouse, touch, and pen input all work the same way. Each gesture is locked to its pointer, with fast drags and cancellation handled.</p>
      </div>
    </div>
  </section>

  <section id="faq" class="section section--subtle">
    <div class="section-label">Frequently asked</div>
    <div class="faq-list">
      {faq.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <GitHubCTA />
</Layout>
