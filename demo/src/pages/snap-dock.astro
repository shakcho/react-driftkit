---
import Layout from '../layouts/Layout.astro';
import WidgetHeader from '../components/WidgetHeader.astro';
import InstallSection from '../components/InstallSection.astro';
import ApiTable from '../components/ApiTable.astro';
import CodeExamplesSection from '../components/CodeExamplesSection.astro';
import GitHubCTA from '../components/GitHubCTA.astro';
import { DockGlyphIcon } from '../components/islands/Icons';
import DockDemo from '../components/islands/DockDemo';
import { dockMeta } from '../data/dock';
import { componentJsonLd, componentPageTitle } from '../lib/seo';
---

<Layout
  title={componentPageTitle(dockMeta)}
  description={dockMeta.metaDescription}
  path={`/${dockMeta.slug}`}
  keywords={dockMeta.seoKeywords}
  jsonLd={componentJsonLd(dockMeta)}
  activeComponent="dock"
  ogSlug={dockMeta.slug}
>
  <WidgetHeader
    prefix="dock"
    icon={DockGlyphIcon}
    title={dockMeta.title}
    description={dockMeta.tagline}
  />

  <InstallSection id="dock-install" />

  <section id="dock-demo" class="section" style="padding-top: 16px;">
    <div class="section-label">Interactive Demo</div>
    <DockDemo client:load />
  </section>

  <section id="dock-api" class="section" style="padding-top: 0;">
    <div class="section-label">API Reference</div>
    <ApiTable rows={dockMeta.apiRows} footnoteHtml={dockMeta.apiFootnoteHtml} />
  </section>

  <CodeExamplesSection
    id="dock-examples"
    examples={dockMeta.codeExamples}
    typesCode={dockMeta.typesCode}
  />

  <GitHubCTA />
</Layout>
