{
  "name": "react-driftkit",
  "version": "0.8.0",
  "description": "Small React primitives for floating UI: draggable launchers and edge-pinned docks",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./MovableLauncher": {
      "types": "./dist/MovableLauncher.d.ts",
      "import": "./dist/MovableLauncher.js",
      "require": "./dist/MovableLauncher.cjs"
    },
    "./SnapDock": {
      "types": "./dist/SnapDock.d.ts",
      "import": "./dist/SnapDock.js",
      "require": "./dist/SnapDock.cjs"
    },
    "./DraggableSheet": {
      "types": "./dist/DraggableSheet.d.ts",
      "import": "./dist/DraggableSheet.js",
      "require": "./dist/DraggableSheet.cjs"
    },
    "./ResizableSplitPane": {
      "types": "./dist/ResizableSplitPane.d.ts",
      "import": "./dist/ResizableSplitPane.js",
      "require": "./dist/ResizableSplitPane.cjs"
    },
    "./ZoomLens": {
      "types": "./dist/ZoomLens.d.ts",
      "import": "./dist/ZoomLens.js",
      "require": "./dist/ZoomLens.cjs"
    },
    "./FlickDeck": {
      "types": "./dist/FlickDeck.d.ts",
      "import": "./dist/FlickDeck.js",
      "require": "./dist/FlickDeck.cjs"
    },
    "./PullToRefresh": {
      "types": "./dist/PullToRefresh.d.ts",
      "import": "./dist/PullToRefresh.js",
      "require": "./dist/PullToRefresh.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "astro dev --root demo",
    "build": "vite build && tsc --emitDeclarationOnly",
    "build:demo": "astro build --root demo",
    "og": "node demo/scripts/gen-og.mjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shakcho/react-driftkit.git"
  },
  "homepage": "https://react-driftkit.saktichourasia.dev/",
  "bugs": {
    "url": "https://github.com/shakcho/react-driftkit/issues"
  },
  "author": "Sakti Kumar Chourasia",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@astrojs/react": "^5.0.3",
    "@astrojs/sitemap": "^3.7.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "astro": "^6.1.8",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^29.0.1",
    "satori": "^0.26.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "react",
    "react18",
    "react19",
    "typescript",
    "driftkit",
    "react-driftkit",
    "ui",
    "ui-components",
    "ui-library",
    "tree-shakable",
    "unstyled",
    "floating",
    "floating-ui",
    "draggable",
    "movable",
    "widget",
    "chat-widget",
    "launcher",
    "dock",
    "toolbar",
    "sidebar",
    "bottom-sheet",
    "drawer",
    "pull-up-sheet",
    "split-pane",
    "split-view",
    "resizable",
    "resizable-panels",
    "allotment",
    "magnifier",
    "zoom",
    "zoom-lens",
    "image-zoom",
    "product-zoom",
    "card-stack",
    "swipeable-cards",
    "flick-deck",
    "pull-to-refresh",
    "pull-down-to-refresh",
    "swipe-to-refresh",
    "refresh",
    "overscroll",
    "react-pull-to-refresh",
    "react-simple-pull-to-refresh",
    "rmc-pull-to-refresh",
    "infinite-scroll",
    "hooks",
    "react-hooks",
    "use-drag",
    "usedrag",
    "drag-hook",
    "gesture",
    "gestures",
    "pointer-events",
    "use-gesture",
    "@use-gesture/react",
    "react-use-gesture",
    "react-draggable",
    "use-long-press",
    "long-press",
    "inertia",
    "momentum",
    "snap-points",
    "use-local-storage",
    "persisted-state",
    "prefers-reduced-motion"
  ],
  "license": "MIT"
}
